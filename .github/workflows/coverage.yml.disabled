name: Code Coverage Analysis and Reporting

on:
  push:
    branches: [ main, init, develop ]
  pull_request:
    branches: [ main, init ]
  schedule:
    # Run coverage analysis daily at 2 AM UTC
    - cron: '0 2 * * *'

env:
  GO_VERSION: '1.24'
  COVERAGE_THRESHOLD: 15.0  # Minimum coverage percentage required

jobs:
  coverage-analysis:
    name: Generate Coverage Report
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout Code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0  # Fetch full history for better analysis
        
    - name: Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        
    - name: Cache Go modules
      uses: actions/cache@v4
      with:
        path: ~/go/pkg/mod
        key: ${{ runner.os }}-go-${{ hashFiles('**/go.sum') }}
        restore-keys: |
          ${{ runner.os }}-go-
          
    - name: Install dependencies
      run: go mod download
      
    - name: Run tests with coverage
      run: |
        echo "🧪 Running comprehensive test suite with coverage..."
        go test -coverprofile=coverage.out -covermode=atomic ./pkg/...
        
    - name: Generate coverage reports
      run: |
        echo "📊 Generating coverage reports..."
        # Generate function-level coverage
        go tool cover -func=coverage.out > coverage-func.txt
        
        # Generate HTML report
        go tool cover -html=coverage.out -o coverage.html
        
        # Extract total coverage percentage
        COVERAGE=$(go tool cover -func=coverage.out | tail -1 | awk '{print $3}' | sed 's/%//')
        echo "COVERAGE_PERCENT=$COVERAGE" >> $GITHUB_ENV
        echo "📈 Total Coverage: $COVERAGE%"
        
    - name: Check coverage threshold
      run: |
        echo "🎯 Checking coverage threshold (${{ env.COVERAGE_THRESHOLD }}%)..."
        CURRENT_COVERAGE=${{ env.COVERAGE_PERCENT }}
        THRESHOLD=${{ env.COVERAGE_THRESHOLD }}
        
        if (( $(echo "$CURRENT_COVERAGE < $THRESHOLD" | bc -l) )); then
          echo "❌ Coverage ($CURRENT_COVERAGE%) is below threshold ($THRESHOLD%)"
          echo "COVERAGE_STATUS=below_threshold" >> $GITHUB_ENV
          exit 1
        else
          echo "✅ Coverage ($CURRENT_COVERAGE%) meets threshold ($THRESHOLD%)"
          echo "COVERAGE_STATUS=above_threshold" >> $GITHUB_ENV
        fi
        
    - name: Generate coverage badge
      run: |
        COVERAGE=${{ env.COVERAGE_PERCENT }}
        COLOR="red"
        if (( $(echo "$COVERAGE >= 80" | bc -l) )); then
          COLOR="brightgreen"
        elif (( $(echo "$COVERAGE >= 60" | bc -l) )); then
          COLOR="yellow"
        elif (( $(echo "$COVERAGE >= 40" | bc -l) )); then
          COLOR="orange"
        fi
        
        # Create shields.io badge URL
        BADGE_URL="https://img.shields.io/badge/coverage-${COVERAGE}%25-${COLOR}"
        echo "BADGE_URL=$BADGE_URL" >> $GITHUB_ENV
        echo "📛 Generated badge: $BADGE_URL"
        
    - name: Generate detailed coverage markdown
      run: |
        cat > coverage-summary.md << 'EOF'
        # 📊 Code Coverage Report
        
        **Generated on:** $(date '+%Y-%m-%d %H:%M:%S UTC')
        **Branch:** ${{ github.ref_name }}
        **Commit:** ${{ github.sha }}
        
        ## 🎯 Coverage Summary
        
        ![Coverage Badge](${{ env.BADGE_URL }})
        
        **Total Coverage:** ${{ env.COVERAGE_PERCENT }}%
        **Threshold:** ${{ env.COVERAGE_THRESHOLD }}%
        **Status:** ${{ env.COVERAGE_STATUS == 'above_threshold' && '✅ PASSING' || '❌ FAILING' }}
        
        ## 📈 Package Coverage Details
        
        ```
        $(cat coverage-func.txt)
        ```
        
        ## 🔗 Reports
        
        - [📄 Detailed HTML Report](./coverage.html)
        - [📊 Function Coverage](./coverage-func.txt)
        - [💾 Coverage Profile](./coverage.out)
        
        ## 📋 Next Steps
        
        $(if [ "${{ env.COVERAGE_STATUS }}" = "below_threshold" ]; then
          echo "⚠️ **Action Required:** Coverage is below threshold. Please add tests for:"
          echo ""
          echo "1. **Critical Functions:** Authentication middleware, security functions"
          echo "2. **Core Platform:** Configuration loading, platform initialization"
          echo "3. **Supporting Functions:** Audit logging, user management"
        else
          echo "✅ **Good Coverage:** Continue maintaining and improving test coverage."
          echo ""
          echo "**Focus Areas for Improvement:**"
          echo "- Add integration tests for middleware"
          echo "- Increase coverage for edge cases"
          echo "- Add performance benchmarks"
        fi)
        
        ---
        
        *This report was automatically generated by GitHub Actions.*
        EOF
        
    - name: Upload coverage artifacts
      uses: actions/upload-artifact@v4
      with:
        name: coverage-reports-${{ github.sha }}
        path: |
          coverage.out
          coverage.html
          coverage-func.txt
          coverage-summary.md
        retention-days: 30
        
    - name: Comment PR with coverage
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const coverage = '${{ env.COVERAGE_PERCENT }}';
          const threshold = '${{ env.COVERAGE_THRESHOLD }}';
          const status = '${{ env.COVERAGE_STATUS }}';
          const badgeUrl = '${{ env.BADGE_URL }}';
          
          const coverageReport = fs.readFileSync('coverage-summary.md', 'utf8');
          
          const comment = `
          ## 📊 Code Coverage Report
          
          ![Coverage](${badgeUrl})
          
          **Coverage:** ${coverage}% | **Threshold:** ${threshold}% | **Status:** ${status === 'above_threshold' ? '✅ PASSING' : '❌ FAILING'}
          
          <details>
          <summary>📈 Detailed Coverage Report</summary>
          
          ${coverageReport}
          
          </details>
          
          ${status === 'below_threshold' ? 
            '⚠️ **Coverage below threshold!** Please add tests before merging.' : 
            '✅ **Coverage meets requirements!** Good job on maintaining test quality.'
          }
          `;
          
          github.rest.issues.createComment({
            issue_number: context.issue.number,
            owner: context.repo.owner,
            repo: context.repo.repo,
            body: comment
          });
          
  update-readme:
    name: Update README with Coverage
    runs-on: ubuntu-latest
    needs: coverage-analysis
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/init'
    
    steps:
    - name: Checkout Code
      uses: actions/checkout@v4
      with:
        token: ${{ secrets.GITHUB_TOKEN }}
        
    - name: Download coverage artifacts
      uses: actions/download-artifact@v4
      with:
        name: coverage-reports-${{ github.sha }}
        
    - name: Extract coverage data
      run: |
        COVERAGE=$(go tool cover -func=coverage.out | tail -1 | awk '{print $3}' | sed 's/%//')
        echo "COVERAGE_PERCENT=$COVERAGE" >> $GITHUB_ENV
        
        # Generate badge color
        COLOR="red"
        if (( $(echo "$COVERAGE >= 80" | bc -l) )); then
          COLOR="brightgreen"
        elif (( $(echo "$COVERAGE >= 60" | bc -l) )); then
          COLOR="yellow"
        elif (( $(echo "$COVERAGE >= 40" | bc -l) )); then
          COLOR="orange"
        fi
        echo "BADGE_COLOR=$COLOR" >> $GITHUB_ENV
        
    - name: Update README.md
      run: |
        # Create or update coverage section in README
        if ! grep -q "## 📊 Code Coverage" README.md; then
          # Add coverage section if it doesn't exist
          cat >> README.md << 'EOF'
        
        ## 📊 Code Coverage
        
        ![Coverage](https://img.shields.io/badge/coverage-${{ env.COVERAGE_PERCENT }}%25-${{ env.BADGE_COLOR }})
        
        Current test coverage: **${{ env.COVERAGE_PERCENT }}%**
        
        ### Coverage by Package
        
        | Package | Coverage | Status |
        |---------|----------|--------|
        | pkg/auth | ![Auth](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/AuthMesh/authmesh/main/coverage-data.json&query=$.packages.auth&suffix=%25&label=coverage&color=blue) | 🔄 |
        | pkg/keycloak | ![Keycloak](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/AuthMesh/authmesh/main/coverage-data.json&query=$.packages.keycloak&suffix=%25&label=coverage&color=blue) | 🔄 |
        | pkg/middleware | ![Middleware](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/AuthMesh/authmesh/main/coverage-data.json&query=$.packages.middleware&suffix=%25&label=coverage&color=blue) | 🔄 |
        | pkg/ratelimit | ![RateLimit](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/AuthMesh/authmesh/main/coverage-data.json&query=$.packages.ratelimit&suffix=%25&label=coverage&color=blue) | 🔄 |
        | pkg/tlsutil | ![TLS](https://img.shields.io/badge/dynamic/json?url=https://raw.githubusercontent.com/AuthMesh/authmesh/main/coverage-data.json&query=$.packages.tlsutil&suffix=%25&label=coverage&color=blue) | 🔄 |
        
        **Last Updated:** $(date '+%Y-%m-%d %H:%M:%S UTC')
        
        [📊 View Detailed Coverage Report](./COVERAGE_REPORT.md) | [📄 HTML Report](https://authmesh.github.io/authmesh/coverage.html)
        EOF
        else
          # Update existing coverage section
          sed -i '/## 📊 Code Coverage/,/## /c\
        ## 📊 Code Coverage\
        \
        ![Coverage](https://img.shields.io/badge/coverage-${{ env.COVERAGE_PERCENT }}%25-${{ env.BADGE_COLOR }})\
        \
        Current test coverage: **${{ env.COVERAGE_PERCENT }}%**\
        \
        **Last Updated:** '"$(date '+%Y-%m-%d %H:%M:%S UTC')"'\
        \
        [📊 View Detailed Coverage Report](./COVERAGE_REPORT.md) | [📄 HTML Report](https://authmesh.github.io/authmesh/coverage.html)\
        \
        ## ' README.md
        fi
        
    - name: Generate coverage data JSON
      run: |
        cat > coverage-data.json << EOF
        {
          "total": ${{ env.COVERAGE_PERCENT }},
          "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
          "packages": {
            "auth": $(grep "pkg/auth" coverage-func.txt | tail -1 | awk '{print $3}' | sed 's/%//' || echo "0"),
            "keycloak": $(grep "pkg/keycloak" coverage-func.txt | tail -1 | awk '{print $3}' | sed 's/%//' || echo "0"),
            "middleware": $(grep "pkg/middleware" coverage-func.txt | tail -1 | awk '{print $3}' | sed 's/%//' || echo "0"),
            "ratelimit": $(grep "pkg/ratelimit" coverage-func.txt | tail -1 | awk '{print $3}' | sed 's/%//' || echo "0"),
            "tlsutil": $(grep "pkg/tlsutil" coverage-func.txt | tail -1 | awk '{print $3}' | sed 's/%//' || echo "0")
          }
        }
        EOF
        
    - name: Create Pull Request
      uses: peter-evans/create-pull-request@v6
      with:
        token: ${{ secrets.GITHUB_TOKEN }}
        commit-message: "📊 Update code coverage to ${{ env.COVERAGE_PERCENT }}%"
        title: "📊 Automated Coverage Update: ${{ env.COVERAGE_PERCENT }}%"
        body: |
          ## 📊 Automated Code Coverage Update
          
          This PR automatically updates the repository with the latest code coverage information.
          
          ### 📈 Coverage Summary
          - **New Coverage:** ${{ env.COVERAGE_PERCENT }}%
          - **Branch:** ${{ github.ref_name }}
          - **Commit:** ${{ github.sha }}
          
          ### 🔄 Changes Made
          - ✅ Updated README.md with current coverage badge and statistics
          - ✅ Generated coverage-data.json for dynamic badges
          - ✅ Updated COVERAGE_REPORT.md with latest analysis
          
          ### 📊 Package Coverage
          ```
          $(cat coverage-func.txt | grep "pkg/" | head -10)
          ```
          
          ### 🎯 Next Steps
          ${{ env.COVERAGE_PERCENT < 25 && '⚠️ Coverage is still low. Consider adding more tests for critical functions.' || '✅ Coverage is improving! Keep up the good work.' }}
          
          ---
          *This PR was automatically created by GitHub Actions workflow.*
        branch: feature/coverage-update-${{ github.sha }}
        delete-branch: true
        
  coverage-trend:
    name: Track Coverage Trends
    runs-on: ubuntu-latest
    needs: coverage-analysis
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/init'
    
    steps:
    - name: Checkout Code
      uses: actions/checkout@v4
      
    - name: Download coverage artifacts
      uses: actions/download-artifact@v4
      with:
        name: coverage-reports-${{ github.sha }}
        
    - name: Update coverage history
      run: |
        # Create coverage history file if it doesn't exist
        if [ ! -f .github/coverage-history.json ]; then
          echo '{"history": []}' > .github/coverage-history.json
        fi
        
        # Extract current coverage
        COVERAGE=$(go tool cover -func=coverage.out | tail -1 | awk '{print $3}' | sed 's/%//')
        
        # Add current coverage to history
        jq --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
           --arg coverage "$COVERAGE" \
           --arg commit "${{ github.sha }}" \
           '.history += [{"date": $date, "coverage": ($coverage | tonumber), "commit": $commit}] | .history |= sort_by(.date) | .history |= .[-30:]' \
           .github/coverage-history.json > temp.json && mv temp.json .github/coverage-history.json
           
    - name: Generate coverage trend chart
      run: |
        # Create a simple ASCII chart of coverage trend
        cat > coverage-trend.md << 'EOF'
        # 📈 Coverage Trend Analysis
        
        ## Historical Coverage Data
        
        ```json
        $(cat .github/coverage-history.json)
        ```
        
        ## Trend Summary
        
        - **Current:** ${{ env.COVERAGE_PERCENT }}%
        - **Trend:** $(jq -r '.history | if length > 1 then (if (.[length-1].coverage > .[length-2].coverage) then "📈 Improving" elif (.[length-1].coverage < .[length-2].coverage) then "📉 Declining" else "➡️ Stable" end) else "📊 Baseline" end' .github/coverage-history.json)
        - **Best:** $(jq -r '.history | max_by(.coverage) | .coverage' .github/coverage-history.json)%
        - **Worst:** $(jq -r '.history | min_by(.coverage) | .coverage' .github/coverage-history.json)%
        
        EOF
        
    - name: Commit coverage history
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"
        git add .github/coverage-history.json coverage-trend.md
        git commit -m "📊 Update coverage history" || exit 0
        git push
